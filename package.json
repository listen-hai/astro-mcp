{
  "name": "@lhk714/astro-mcp",
  "version": "0.3.0",
  "description": "Deterministic modern Western astrology natal-chart MCP server: JPL-Horizons-verified ephemeris, honest degradation when birth time is unknown, Chinese-first output",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "astro-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "README_zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test --timeout 60000",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build && bun run test"
  },
  "keywords": [
    "astrology",
    "natal-chart",
    "horoscope",
    "western-astrology",
    "mcp",
    "model-context-protocol",
    "astronomy-engine",
    "ephemeris",
    "claude",
    "bun"
  ],
  "author": "Wesley Liu",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "astronomy-engine": "2.1.19",
    "city-timezones": "1.3.4",
    "geo-tz": "8.1.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "homepage": "https://github.com/listen-hai/astro-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/listen-hai/astro-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/listen-hai/astro-mcp/issues"
  }
}
